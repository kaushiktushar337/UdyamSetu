DATABASE_URL=postgresql://USERNAME:PASSWORD@HOST:PORT/postgres
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/chat/completions
OPENROUTER_TIMEOUT=45
OPENROUTER_MAX_TOKENS=600
MODEL_NAME=paraphrase-multilingual-MiniLM-L12-v2
CHATBOT_SIMILARITY_LIMIT=3
CHATBOT_SIMILARITY_THRESHOLD=0.35
CHATBOT_MAX_CONTEXT_CHARS=6500
CHATBOT_MAX_HISTORY_MESSAGES=8
LOCATION_MATCH_MAX_KM=50
LOCATION_REVERSE_GEOCODE=true
CORS_ORIGINS=http://localhost:5173
ASUSE_MODEL_PATH=models/asuse_profitability.joblib
